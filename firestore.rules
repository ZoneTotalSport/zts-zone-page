rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // userQuotas — gere cote worker via Admin SDK (bypass rules).
    // Pas d'acces direct depuis le client web.
    // ─────────────────────────────────────────────────────────
    match /userQuotas/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // anonGenCount — compteur essais anonymes par fingerprint.
    // Create : count==1, fingerprint string, firstSeen=serverTimestamp.
    // Update : count strictement croissant, plafond 999, lastSeen=serverTimestamp.
    // Delete : interdit.
    // ─────────────────────────────────────────────────────────
    match /anonGenCount/{fingerprint} {
      allow read: if true;
      allow create: if request.resource.data.count == 1
                    && request.resource.data.fingerprint is string
                    && request.resource.data.firstSeen == request.time;
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.count <= 999
                    && request.resource.data.lastSeen == request.time;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // conversionFunnel — append-only events.
    // Lecture/update/delete interdits cote client (analytics interne).
    // ─────────────────────────────────────────────────────────
    match /conversionFunnel/{eventId} {
      allow create: if request.resource.data.timestamp == request.time
                    && request.resource.data.event is string
                    && request.resource.data.source is string;
      allow read, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // leads — courriels captures par le popup newsletter (anonymes).
    // Create-only cote client. Lecture/maj/suppression interdites :
    // l'export passe par la console Firebase.
    //
    // Unique ecrivain : zts-newsletter.js (saveLead). Depuis le 12 aout 2026,
    // le succes de cette ecriture est ce qui decide de ce que voit le visiteur
    // — le worker Resend est debranche. Une regle trop stricte ne perd donc
    // plus seulement un lead : elle envoie quelqu'un vers le chemin d'echec.
    // Toute modification ici se teste AVEC le pop-up, pas seulement au simulateur.
    //
    // `hasOnly` ferme la collection a l'ecriture libre : sans lui, n'importe
    // qui peut y deposer des documents de 1 Mio, en anonyme, autant de fois
    // qu'il veut. Les cinq cles sont exactement celles que saveLead envoie.
    // ─────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'lang', 'page', 'ts'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    // Format : un @ unique, un point apres, aucune espace.
                    // matches() est un match PLEIN en RE2 — pas besoin d'ancres.
                    && request.resource.data.email.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]+')
                    && request.resource.data.ts == request.time;
      allow read, update, delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // PLANIFICATEUR CAMP DE JOUR
    // ═════════════════════════════════════════════════════════

    // ── Organisations ──
    // coordo : lecture/ecriture sur son org.
    // animateur : lecture seulement (via groupes.orgId).
    // Lecture : coordo OU tout utilisateur authentifie (l'animateur
    // fera un get() par ID apres avoir lu son groupe.orgId).
    // L'isolation cross-org est assuree par le fait que seul le
    // coordo peut lister, et l'animateur doit connaitre l'orgId.
    match /organisations/{orgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.coordoUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.coordoUid == request.auth.uid;
    }

    // ── Groupes ──
    // animateur : CRUD sur ses propres groupes.
    // coordo de l'org : lecture.
    match /groupes/{groupeId} {
      // get : animateur du groupe OU coordo de l'org.
      allow get: if request.auth != null
                 && (resource.data.animateurUid == request.auth.uid
                     || isCoordo(resource.data.orgId));
      // list : tout utilisateur authentifie (filtre cote client par animateurUid ou orgId).
      // La securite repose sur le fait que les docs enfants/journees/presences
      // exigent isAnimateurOfGroupe, donc lister les groupes ne donne rien sans droit.
      allow list: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.animateurUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.animateurUid == request.auth.uid;
    }

    // ── Enfants ──
    // animateur du groupe : CRUD. coordo de l'org : lecture (tableau de bord
    // coordo → loadCoordoData liste les enfants de chaque groupe de l'org).
    match /enfants/{enfantId} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(resource.data.groupeId)
                      || isCoordoOfGroupe(resource.data.groupeId));
      allow update, delete: if request.auth != null
                            && isAnimateurOfGroupe(resource.data.groupeId);
      allow create: if request.auth != null
                    && isAnimateurOfGroupe(request.resource.data.groupeId);
    }

    // ── Grilles Type (gabarit de journee) ──
    // animateur du groupe : CRUD.
    match /grillesType/{id} {
      allow read, update, delete: if request.auth != null
                                  && isAnimateurOfGroupe(resource.data.groupeId);
      allow create: if request.auth != null
                    && isAnimateurOfGroupe(request.resource.data.groupeId);
    }

    // ── Journees (blocs embarques) ──
    // animateur : CRUD. coordo de l'org : lecture.
    match /journees/{journeeId} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(resource.data.groupeId)
                      || isCoordoOfGroupe(resource.data.groupeId));
      allow create: if request.auth != null
                    && isAnimateurOfGroupe(request.resource.data.groupeId);
      allow update, delete: if request.auth != null
                            && isAnimateurOfGroupe(resource.data.groupeId);
    }

    // ── Presences (collection separee, donnees de securite) ──
    // animateur : CRUD. coordo : lecture.
    match /presences/{id} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(resource.data.groupeId)
                      || isCoordoOfGroupe(resource.data.groupeId));
      allow create: if request.auth != null
                    && isAnimateurOfGroupe(request.resource.data.groupeId);
      allow update, delete: if request.auth != null
                            && isAnimateurOfGroupe(resource.data.groupeId);
    }

    // ── Semaines (grille hebdo riche du planificateur) ──
    // 1 doc par (groupe, lundi ISO). animateur : CRUD. coordo de l'org : lecture.
    match /semaines/{id} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(resource.data.groupeId)
                      || isCoordoOfGroupe(resource.data.groupeId));
      allow create: if request.auth != null
                    && isAnimateurOfGroupe(request.resource.data.groupeId);
      allow update, delete: if request.auth != null
                            && isAnimateurOfGroupe(resource.data.groupeId);
    }

    // ── Messages (coordo ↔ animateur) ──
    // enfantId='' = fil général du groupe. Lecture/écriture : animateur du groupe OU coordo de l'org.
    // update permis pour marquer lu (les deux parties).
    match /messages/{id} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(resource.data.groupeId)
                      || isCoordoOfGroupe(resource.data.groupeId));
      allow create: if request.auth != null
                    && (isAnimateurOfGroupe(request.resource.data.groupeId)
                        || isCoordoOfGroupe(request.resource.data.groupeId))
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
                    && (isAnimateurOfGroupe(resource.data.groupeId)
                        || isCoordoOfGroupe(resource.data.groupeId));
      allow delete: if false;
    }

    // ── Évaluation PFEQ (ÉP) ──
    // evalConfig : 1 doc par groupe (id = groupeId), colonnes/critères. animateur CRUD, coordo read.
    match /evalConfig/{groupeId} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(groupeId) || isCoordoOfGroupe(groupeId));
      allow write: if request.auth != null && isAnimateurOfGroupe(groupeId);
    }
    // evaluations : 1 doc par (groupe, date, élève, critère). animateur CRUD, coordo read.
    match /evaluations/{id} {
      allow read: if request.auth != null
                  && (isAnimateurOfGroupe(resource.data.groupeId) || isCoordoOfGroupe(resource.data.groupeId));
      allow create: if request.auth != null && isAnimateurOfGroupe(request.resource.data.groupeId);
      allow update, delete: if request.auth != null && isAnimateurOfGroupe(resource.data.groupeId);
    }

    // ── Jeux (banque partagee) ──
    // read : tout utilisateur authentifie. write : admin seulement.
    match /jeux/{jeuId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Helper functions ──

    // Verifie que l'utilisateur est l'animateur du groupe donne.
    function isAnimateurOfGroupe(groupeId) {
      return get(/databases/$(database)/documents/groupes/$(groupeId)).data.animateurUid == request.auth.uid;
    }

    // Verifie que l'utilisateur est coordo de l'org qui possede le groupe.
    function isCoordoOfGroupe(groupeId) {
      let grp = get(/databases/$(database)/documents/groupes/$(groupeId));
      return isCoordo(grp.data.orgId);
    }

    // Verifie que l'utilisateur est coordo de l'org donnee.
    function isCoordo(orgId) {
      return get(/databases/$(database)/documents/organisations/$(orgId)).data.coordoUid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // users — donnees privees par utilisateur (app /entrainement).
    // Chaque utilisateur lit/ecrit uniquement son propre document.
    // ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────
    // performances — app /apps/performances/ (fiches d'observation
    // video PFEQ). Owner-only : chaque enseignant ne voit que les
    // siennes. Les videos ne passent JAMAIS ici (Drive de l'usager).
    // ─────────────────────────────────────────────────────────
    match /performances/{id} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // plans — planificateur v2 (vues sequentielle + annuelle).
    // 1 doc par (groupe, annee, type), owner-only via uid.
    // ─────────────────────────────────────────────────────────
    match /plans/{id} {
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // budget — app privee familiale. Deux types d'espaces :
    //  • COMMUN  (budget/root-famille) : partage entre les membres. Self-join
    //    controle (un 2e membre peut s'ajouter lui-meme, plafond 2 personnes).
    //  • PERSO   (budget/perso-<uid>)  : prive, lisible/ecrivable par le seul
    //    proprietaire (uid dans l'identifiant du doc).
    // ─────────────────────────────────────────────────────────

    // ── Espace COMMUN : doc racine ──
    match /budget/root-famille {
      allow get: if request.auth != null; // lire membres (pour rejoindre)
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.membres;
      // Deja membre : ecriture libre. Sinon : self-join (n'enleve personne,
      // s'ajoute soi-meme, uniquement si <2 membres actuellement).
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.membres
        || (request.resource.data.membres.hasAll(resource.data.membres)
            && request.auth.uid in request.resource.data.membres
            && resource.data.membres.size() < 2)
      );
      allow delete: if false;
    }
    // ── Espace COMMUN : sous-documents (config, transactions, planifs) ──
    match /budget/root-famille/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/budget/root-famille).data.membres;
    }

    // ── Espaces PERSO : proprietaire uniquement (perso-<uid>) ──
    match /budget/{sid} {
      allow read, write: if request.auth != null && sid == ('perso-' + request.auth.uid);
    }
    match /budget/{sid}/{document=**} {
      allow read, write: if request.auth != null && sid == ('perso-' + request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────
    // familles — PWA privee « La Banque » (points/dollars des enfants).
    // Membres = max 2 parents. Un parent qui connait le familleId
    // (code d'invitation) peut uniquement s'ajouter lui-meme.
    // Sous-collections : enfants, actions, transactions, notes.
    // ─────────────────────────────────────────────────────────
    match /familles/{familleId} {

      function estMembreFamille() {
        return request.auth != null && request.auth.uid in resource.data.membres;
      }
      // Rejoindre : s'ajouter soi-meme si <2 membres, sans toucher
      // a autre chose que membres/membresInfo.
      function rejointFamille() {
        return request.auth != null
          && !(request.auth.uid in resource.data.membres)
          && resource.data.membres.size() < 2
          && request.resource.data.membres.size() == resource.data.membres.size() + 1
          && request.resource.data.membres.hasAll(resource.data.membres)
          && request.auth.uid in request.resource.data.membres
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['membres', 'membresInfo']);
      }

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.membres
        && request.resource.data.membres.size() == 1;
      allow read: if estMembreFamille();
      allow update: if estMembreFamille() || rejointFamille();
      allow delete: if estMembreFamille();

      match /{sousCollection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/familles/$(familleId)).data.membres;
      }
    }

    // ─────────────────────────────────────────────────────────
    // article_views — compteur de vues des articles du blog.
    // 1 doc par slug d'article (ex. article_views/nawatobi), ecrit par
    // /article-views.js (ztsCountView) et lu par blog.html.
    //
    // La collection n'avait JAMAIS de bloc ici : elle tombait donc dans le
    // « allow read, write: if false » final. Depuis le 1er deploiement de
    // regles (1915b07, 18 mai 2026), chaque increment ET chaque lecture
    // etaient refuses en silence (le .catch() du client avale l'erreur) —
    // d'ou tous les compteurs affiches a zero.
    //
    // Lecture publique : le nombre de vues est affiche sur blog.html a tout
    // le monde, connecte ou non. Ecriture : +1 strict, comme anonGenCount plus
    // haut. Pas de suppression, pas d'ecrasement : un client ne peut que faire
    // passer count de N a N+1. C'est pour rendre cette validation possible que
    // article-views.js ecrit via une transaction a valeurs explicites plutot
    // qu'avec FieldValue.increment().
    // ─────────────────────────────────────────────────────────
    match /article_views/{slug} {
      allow read: if true;
      allow create: if request.resource.data.count == 1
                    && request.resource.data.last_view == request.time;
      allow update: if request.resource.data.count == resource.data.count + 1
                    && request.resource.data.last_view == request.time;
      allow delete: if false;
    }

    // ═════════════════════════════════════════════════════════
    // FICHES DE JEU  (/fiches, /admin/fiches)
    //
    // Le document est SCINDE volontairement :
    //
    //   fiches/{id}               partie publique — titre, sous-titre,
    //                             etiquettes, illustration de la page 1,
    //                             univers, categorie, statut.
    //   fiches/{id}/prive/contenu partie membre  — but du jeu, sections,
    //                             image de la page 2.
    //
    // Une regle « lecture publique si statut == publie » posee sur un
    // document UNIQUE ne protegerait rien : le deroulement complet partirait
    // dans la meme reponse REST, et le mur d'inscription ne serait qu'un
    // masquage cote navigateur. La coupure est donc dans la donnee.
    //
    // `statut` est recopie dans le document prive pour que sa regle de
    // lecture n'ait pas besoin d'un get() sur le parent : une lecture
    // facturee de moins a chaque affichage de fiche.
    //
    // Le pendant Storage de ces regles vit dans storage.rules
    // (fiches/{id}/pub/* public, fiches/{id}/prive/* connecte). Les deux
    // fichiers doivent bouger ensemble.
    // ═════════════════════════════════════════════════════════

    // Admin unique. Le custom claim est la reference ; le courriel est le
    // repli tant que le claim n'est pas pose (_scripts/zts-admin-claim.js).
    // Firebase Auth interdit deux comptes sur la meme adresse et ce compte
    // existe : l'adresse ne peut pas etre revendiquee par quelqu'un d'autre.
    function estAdminFiches() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'zts@hotmail.ca'
      );
    }

    // ── Sections de publication ──
    // Lecture publique : l'index /fiches en a besoin pour nommer et colorer
    // ses groupes avant toute connexion. Ecriture admin (seed + retouches).
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if estAdminFiches();
    }

    // ── Fiches ──
    match /fiches/{ficheId} {
      allow read: if resource.data.statut == 'publie' || estAdminFiches();

      // Le slug entre dans une URL : on le contraint ici plutot que de
      // faire confiance au navigateur. matches() est un match PLEIN en RE2.
      allow create, update: if estAdminFiches()
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() > 0
                    && request.resource.data.slug.size() <= 80
                    && request.resource.data.slug.matches('[a-z0-9]+(-[a-z0-9]+)*')
                    && request.resource.data.statut in ['brouillon', 'publie']
                    && request.resource.data.titre is string
                    && request.resource.data.titre.size() < 200;

      allow delete: if estAdminFiches();

      // ── Partie reservee aux membres ──
      match /prive/{doc} {
        allow read: if (request.auth != null && resource.data.statut == 'publie')
                    || estAdminFiches();
        allow write: if estAdminFiches();
      }
    }

    // ─────────────────────────────────────────────────────────
    // Tout le reste : interdit par defaut.
    // ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
