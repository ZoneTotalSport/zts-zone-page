rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
// Firebase Storage — projet zone-total-sport
//
// Ce fichier est la SOURCE DE VERITE des regles Storage, au meme titre que
// firestore.rules pour Firestore : tout deploiement passe par un commit
// d'abord, jamais par une edition en console sans rapatriement immediat
// (meme regle d'or que CLAUDE.md § Firebase).
//
// Deploiement :  firebase deploy --only storage
// ═══════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // Admin unique. Le custom claim est la reference ; le courriel est le
    // repli tant que le claim n'est pas pose (voir _scripts/zts-admin-claim.js).
    // Firebase Auth interdit deux comptes avec la meme adresse, et ce compte
    // existe deja : personne ne peut se l'attribuer.
    function estAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'zts@hotmail.ca'
      );
    }

    // 5 Mio : le client redimensionne a 1600 px et encode en JPEG avant
    // d'envoyer (zts-image-slot.js), donc une image normale pese moins de
    // 500 Ko. Le plafond n'est la que pour borner un client modifie.
    function imageValide() {
      return request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType == 'image/jpeg';
    }

    // ── Fiches de jeu ──────────────────────────────────────────────────
    //
    // pub/   illustration de la page 1 : vignette de l'index, image og:.
    //        Lisible par tout le monde, y compris les robots sociaux.
    // prive/ tout le reste (image de la page 2, illustrations des sections).
    //        Reserve aux membres connectes — c'est la moitie Storage du mur
    //        d'inscription, l'autre etant fiches/{id}/prive/contenu dans
    //        Firestore. Les deux doivent bouger ensemble.

    match /fiches/{ficheId}/pub/{fichier} {
      allow read: if true;
      allow write: if estAdmin() && imageValide();
    }

    match /fiches/{ficheId}/prive/{fichier} {
      allow read: if request.auth != null;
      allow write: if estAdmin() && imageValide();
    }

    // ── Tout le reste : interdit par defaut. ───────────────────────────
    match /{chemin=**} {
      allow read, write: if false;
    }
  }
}
