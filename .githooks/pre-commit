#!/bin/sh
# Garde-fou local du chantier d'habillage — voir DETTE-TECHNIQUE-HABILLAGE.md D18.
#
# Installation :  git config core.hooksPath .githooks
# Contournement ponctuel :  git commit --no-verify
racine=$(git rev-parse --show-toplevel)

echo "→ conformité de l'habillage…"
python3 "$racine/_scripts/verifie-habillage.py" || {
  echo
  echo "COMMIT REFUSÉ — voir ci-dessus."
  echo "Le défaut le plus courant est l'ordre de chargement : ztsh-shell.css"
  echo "doit venir APRÈS shared/zts.css, zts-header.css et zts-ultra.css."
  echo "La panne serait silencieuse : ni erreur console, ni défaut visible."
  exit 1
}

echo "→ glyphes de la police de marque…"
python3 "$racine/_scripts/verifie-glyphes-ztsh.py" || {
  echo
  echo "COMMIT REFUSÉ — ponctuation absente de ZoneTotalSport dans un .ztsh-titre."
  echo "Apostrophe droite, guillemets droits, tiret simple. Voir ztsh-shell.css §2."
  exit 1
}
